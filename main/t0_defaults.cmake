# This machine has two physical axes; the core retains its virtual Z axis.
# Existing NVS settings take precedence over these factory defaults.
set(T0_MICROSTEPS 256 CACHE STRING "STSPIN220 hardware microsteps; 0 blocks automatic calibration")
target_compile_definitions(${COMPONENT_LIB} PUBLIC
    T0_MICROSTEPS=${T0_MICROSTEPS}
    DEFAULT_DIR_SIGNALS_INVERT_MASK=3
    DEFAULT_ENABLE_SIGNALS_INVERT_MASK=0
    DEFAULT_LIMIT_SIGNALS_INVERT_MASK=3
    DEFAULT_LIMIT_SIGNALS_PULLUP_DISABLE_MASK=0
    DEFAULT_HARD_LIMIT_ENABLE=1
    DEFAULT_HOMING_ENABLE=1
    DEFAULT_HOMING_INIT_LOCK=1
    DEFAULT_HOMING_FORCE_SET_ORIGIN=0
    DEFAULT_HOMING_DIR_MASK=0
    DEFAULT_HOMING_CYCLE_0=3
    DEFAULT_HOMING_CYCLE_1=0
    DEFAULT_HOMING_CYCLE_2=0
    DEFAULT_HOMING_SEEK_RATE=1500.0f
    DEFAULT_HOMING_FEED_RATE=1500.0f
    DEFAULT_HOMING_PULLOFF=1.0f
    DEFAULT_X_MAX_TRAVEL=42.0f
    DEFAULT_Y_MAX_TRAVEL=42.0f
    DEFAULT_LASER_MODE=1
    DEFAULT_RUN_STARTUP_SCRIPTS_ONLY_ON_HOMED=1
)
if(T0_MICROSTEPS GREATER 0)
    # 360 / 18 degrees / 3mm lead = 20 / 3 full steps per mm.
    target_compile_definitions(${COMPONENT_LIB} PUBLIC
        "DEFAULT_X_STEPS_PER_MM=(20.0f*${T0_MICROSTEPS}/3.0f)"
        "DEFAULT_Y_STEPS_PER_MM=(20.0f*${T0_MICROSTEPS}/3.0f)"
    )
endif()
